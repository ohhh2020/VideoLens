# 视觉理解和文本总结使用的大模型接口，兼容 OpenAI 协议
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VLM_MODEL=gpt-4o-mini
LLM_MODEL=gpt-4o-mini

# 本地语音转写
ASR_MODEL=base
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

# 关键帧策略
FRAME_INTERVAL=8
MAX_FRAMES=20

# 路径
VIDEO_DIR=data/videos
OUTPUT_DIR=data/output

# 如需下载需要登录的视频，填写 cookie 文件路径
COOKIES_FILE=

