# =============================================================================
# 知影 (ZhiYing) —— 环境变量模板
#
# 用法：cp .env.template .env 后填入真实值。.env 已在 .gitignore 中排除。
#
# 覆盖规则（优先级从高到低）：
#   1. 环境变量   ZH_YING__<段>__<键>       ← 本文件主要用这个
#   2. data/user_settings.json（网页设置页保存的运行时偏好）
#   3. configs/app_config.yaml
#   4. 代码内 dataclass 默认值
#
# 层级用双下划线表示，可任意嵌套：
#   ZH_YING__CHUNK__MIN_MS=12000
#   ZH_YING__RETRIEVAL__WEIGHTS__TEXT=1.0
#
# 未在 configs/app_config.yaml 中声明的键会导致启动报错（防止拼写错误静默生效）。
# =============================================================================

# -----------------------------------------------------------------------------
# 密钥（唯一必须手动填写的部分，均为「环境变量名」而非值本身）
# -----------------------------------------------------------------------------
# 留空则 llm.mode=auto 时自动降级到本地 llama.cpp
OPENAI_API_KEY=

# 服务端访问令牌；非空时 API 要求 Authorization: Bearer <值>
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
ZHIYING_API_TOKEN=

# HuggingFace Token（仅下载 gated 模型时需要）
HF_TOKEN=
# ModelScope Token（国内源限流时填写）
MODELSCOPE_API_TOKEN=

# HuggingFace 镜像端点，留空则用 configs/models.yaml 里的 hf_endpoint
# HF_ENDPOINT=https://hf-mirror.com

# -----------------------------------------------------------------------------
# 项目根（仅当从非项目目录启动时需要）
# -----------------------------------------------------------------------------
# ZH_YING_PROJECT_ROOT=D:/VideoLens

# -----------------------------------------------------------------------------
# 设备与降级（无 GPU 的机器通常无需改动）
# -----------------------------------------------------------------------------
# auto / cuda / cpu / mps
# ZH_YING__MODELS__DEVICE=auto
# ZH_YING__MODELS__ALLOW_CPU_FALLBACK=true

# GPU 显存不足时可同时驻留的模型数，超出按 LRU 释放
# ZH_YING__MODELS__MAX_LOADED_MODELS=1

# ASR 计算精度：int8（CPU 最快）/ int8_float16 / float16 / float32
# ZH_YING__ASR__COMPUTE_TYPE=int8

# -----------------------------------------------------------------------------
# 切片与检索（10~30s 硬区间，改动前请确认 overlap 约束）
# -----------------------------------------------------------------------------
# ZH_YING__CHUNK__MIN_MS=10000
# ZH_YING__CHUNK__MAX_MS=30000
# ZH_YING__CHUNK__TARGET_MS=20000
# ZH_YING__CHUNK__OVERLAP_MS=1500
# ZH_YING__CHUNK__SILENCE_MS=600

# ZH_YING__RETRIEVAL__TOP_K=6
# ZH_YING__RETRIEVAL__RRF_K=60
# ZH_YING__RETRIEVAL__MIN_SCORE=0.05
# ZH_YING__RETRIEVAL__WEIGHTS__TEXT=1.0
# ZH_YING__RETRIEVAL__WEIGHTS__IMAGE=0.8
# ZH_YING__RETRIEVAL__WEIGHTS__BM25=0.6

# -----------------------------------------------------------------------------
# 抽帧质量（需求文档：短边 ≥720p、单帧 ≤200KB）
# -----------------------------------------------------------------------------
# ZH_YING__MEDIA__SCENE_DETECT__KEYFRAME__MIN_SHORT_SIDE=720
# ZH_YING__MEDIA__SCENE_DETECT__KEYFRAME__MAX_JPEG_BYTES=204800
# ZH_YING__MEDIA__SCENE_DETECT__BLUR_THRESHOLD=60.0
# ZH_YING__MEDIA__SCENE_DETECT__FRAMES_PER_SCENE=2

# -----------------------------------------------------------------------------
# 数据目录（默认全在 ./data 下，改到其它盘时只改这里）
# -----------------------------------------------------------------------------
# ZH_YING__PATHS__DATA=D:/zhiying-data
# ZH_YING__PATHS__MODELS=D:/zhiying-models
# ZH_YING__PATHS__CHROMA=D:/zhiying-data/chroma
# ZH_YING__PATHS__SQLITE=D:/zhiying-data/zhiying.db

# -----------------------------------------------------------------------------
# LLM 网关（云端 / 本地）
# -----------------------------------------------------------------------------
# auto / cloud / local
# ZH_YING__LLM__MODE=auto
# ZH_YING__LLM__CLOUD__BASE_URL=https://api.openai.com/v1
# ZH_YING__LLM__CLOUD__MODEL=gpt-4o-mini
# ZH_YING__LLM__CLOUD__API_KEY_ENV=OPENAI_API_KEY
# ZH_YING__LLM__CLOUD__TIMEOUT_S=60

# 本地推理线程数；留空 = 物理核数
# ZH_YING__LLM__LOCAL__N_THREADS=8
# 卸载到 GPU 的层数；-1 = 全部（无 GPU 时自动降为 0）
# ZH_YING__LLM__LOCAL__N_GPU_LAYERS=-1
# ZH_YING__LLM__LOCAL__N_CTX=8192

# -----------------------------------------------------------------------------
# 服务接口
# -----------------------------------------------------------------------------
# ZH_YING__API__HOST=127.0.0.1
# ZH_YING__API__PORT=8000
# ZH_YING__GRADIO__PORT=7860
# ZH_YING__MCP__TRANSPORT=stdio

# -----------------------------------------------------------------------------
# 日志
# -----------------------------------------------------------------------------
# DEBUG / INFO / WARNING / ERROR / CRITICAL
# ZH_YING__LOGGING__LEVEL=INFO
# 本地模式下是否严格禁止记录视频路径与转录正文
# ZH_YING__LOGGING__LOCAL_MODE_STRICT=true
